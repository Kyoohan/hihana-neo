{
  // 게시판 글 AI 요약 — 글 내용 해시마다 한 번만 만들고 KV 에 보관해 모든 사용자가 나눠 씁니다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hihana-summary",
  "account_id": "ed28d132ab27af237f04075599bf9241",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "SUMMARIES", "id": "035d5e8deb934d1abda5dacfff23a839" }],
  // 클래스룸 중계 암호문 (src/bridge.ts) — 15분마다 쓰기가 많아 KV 대신 D1.
  "d1_databases": [{ "binding": "BRIDGE", "database_name": "hihana-bridge", "database_id": "5029d8ba-7182-4c72-850e-26dc44886dfd" }],
  "observability": { "enabled": true }
}
