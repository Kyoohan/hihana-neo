<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HiHanaEvo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Android 12+ 시작 화면 — HiHana Evo 로고(240dp 캔버스, 지름 160dp 안)를 창 배경 위에 바로. -->
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/hihana_splash_icon</item>
    </style>
</resources>
