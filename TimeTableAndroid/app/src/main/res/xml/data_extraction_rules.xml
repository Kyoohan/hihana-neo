<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 백업·기기 이전 제외 목록 — backup_rules.xml 과 같은 이유. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="hana_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="hana_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
