<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 실시간 업데이트(Now Bar·상태 바 칩) — 일반 권한이라 설치 시 부여됩니다 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 삼성 One UI 의 Now Bar 는 이 feature 를 선언한 앱만 "실시간 정보" 목록에 올리고 Now Bar·상태 바 칩에 보여줍니다
         (Perplexity 등 Now Bar 를 지원하는 서드파티 앱의 매니페스트에서 확인). required=false 라 다른 기기엔 영향 없음 -->
    <uses-feature android:name="com.samsung.feature.nowbar" android:required="false" />
    <!-- 위젯 블록 전환을 정확한 시각에 다시 그리기 위한 exact alarm (13+ 에서는 사용자가 설정에서 허용) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 앱 내 업데이트: 받은 APK 를 설치기로 넘기기 위해 필요 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".TimeTableApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.TimeTable">

        <!-- 삼성 Now Bar "실시간 정보(Ongoing Activity)" 지원 선언 — 스타벅스·카카오 T 등 Now Bar 에 뜨는 서드파티 앱이
             모두 갖고 있는 메타데이터. 이게 있어야 알림 설정에 allowOngoingActivity 가 붙어 실시간 알림이 Now Bar 로 갑니다. -->
        <meta-data android:name="com.samsung.android.support.ongoing_activity" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TimeTable">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.TimeTable">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.TimeTableWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timetable_widget_info" />
        </receiver>

        <!-- 진행 막대를 1분 간격으로 다시 그리는 틱(자기 자신을 재예약) + 블록 전환 시각의 exact alarm -->
        <receiver
            android:name=".widget.WidgetTickReceiver"
            android:exported="false" />

        <!-- 실시간 일정(Now Bar) 알림의 1분 틱·구간 경계 알람, 부팅 후 복구 -->
        <receiver
            android:name=".LiveActivityReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 앱 내 업데이트로 받은 APK 를 패키지 설치기에 넘기는 content URI 제공자 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
